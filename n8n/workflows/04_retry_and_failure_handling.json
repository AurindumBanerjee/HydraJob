{
  "name": "HydraJob 04 - Retry & Failure Handling",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 2
            }
          ]
        }
      },
      "id": "node-schedule-retry",
      "name": "Schedule - Every 2 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.HYDRAJOB_API_BASE_URL || 'http://backend:8000') + '/api/v1/discovery/failed-sources' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      },
      "id": "node-http-failed-sources",
      "name": "HTTP Request - Get Failed Sources",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_N8N_HEADER_AUTH_CREDENTIAL_ID",
          "name": "HydraJob X-API-Key"
        }
      }
    },
    {
      "parameters": {
        "fieldToSplitOut": "items",
        "options": {}
      },
      "id": "node-split-failed",
      "name": "Split Out - Failed Sources",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-retry-budget",
              "leftValue": "={{ Number($json.consecutive_failures || 0) }}",
              "rightValue": 3,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-if-retry-budget",
      "name": "IF - Within Retry Limit",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.HYDRAJOB_API_BASE_URL || 'http://backend:8000') + '/api/v1/discovery/scan-source/' + $json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        }
      },
      "id": "node-http-retry-scan",
      "name": "HTTP Request - Retry Source Scan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1140, 220],
      "continueOnFail": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_N8N_HEADER_AUTH_CREDENTIAL_ID",
          "name": "HydraJob X-API-Key"
        }
      }
    },
    {
      "parameters": {},
      "id": "node-escalate-dashboard",
      "name": "Surface in Dashboard System Health",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1140, 380]
    }
  ],
  "connections": {
    "Schedule - Every 2 Hours": {
      "main": [
        [
          {
            "node": "HTTP Request - Get Failed Sources",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request - Get Failed Sources": {
      "main": [
        [
          {
            "node": "Split Out - Failed Sources",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Out - Failed Sources": {
      "main": [
        [
          {
            "node": "IF - Within Retry Limit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF - Within Retry Limit": {
      "main": [
        [
          {
            "node": "HTTP Request - Retry Source Scan",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Surface in Dashboard System Health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata"
  },
  "pinData": {},
  "tags": ["hydrajob", "phase-7", "retry"]
}
