# ==============================================================================
# HydraJob Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` for local development or production deployment:
#   cp .env.example .env
#
# NEVER commit a real `.env` file or real credentials to Git.
#
# Generate strong secrets before starting services:
#   python supporting_codes/generate_secrets.py
# Or using OpenSSL:
#   openssl rand -base64 36   # for APP_SECRET_KEY / APP_API_KEY
#   openssl rand -hex 32      # for N8N_ENCRYPTION_KEY
# ==============================================================================

# --- Application --------------------------------------------------------------
APP_ENV=development
APP_SECRET_KEY=replace-with-generated-app-secret-key
# Optional in development (leave blank to allow unauthenticated local /api/v1/* calls,
# or set a strong key to enforce X-API-Key header validation across backend, dashboard, and n8n).
APP_API_KEY=replace-with-generated-app-api-key
LOG_LEVEL=INFO
TZ=Asia/Kolkata

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=hydrajob
POSTGRES_TEST_DB=hydrajob_test
POSTGRES_USER=hydrajob
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_PORT=5432
# Inside Docker Compose, host is `postgres`; for local host-run commands use `localhost`.
DATABASE_URL=postgresql+psycopg://hydrajob:replace-with-strong-postgres-password@postgres:5432/hydrajob

# --- n8n Orchestration --------------------------------------------------------
# Must be at least 32 chars (64 hex chars recommended). Keep backed up; losing this
# key makes stored n8n credentials unreadable.
N8N_ENCRYPTION_KEY=replace-with-64-hex-char-n8n-encryption-key
N8N_DB_NAME=n8n
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=Asia/Kolkata

# --- Ollama (Private Docker Network Only) -------------------------------------
# Keep Ollama private on the Docker network (never publish port 11434 publicly).
OLLAMA_BASE_URL=http://ollama:11434
# Pull explicitly after startup: `docker compose exec ollama ollama pull qwen2.5:7b-instruct`
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_REQUEST_TIMEOUT=30.0
OLLAMA_KEEP_ALIVE=5m

# --- Service URLs -------------------------------------------------------------
# Used by local host scripts/docs; inside Docker, dashboard connects strictly to http://backend:8000.
API_BASE_URL=http://localhost:8000
DASHBOARD_URL=http://localhost:8501
BACKEND_PORT=8000
DASHBOARD_PORT=8501

# --- Production Reverse Proxy (Caddy) -----------------------------------------
# Set DOMAIN_NAME to your EC2 domain/subdomain for automatic Let's Encrypt HTTPS.
DOMAIN_NAME=localhost
# Generate CADDY_BASIC_AUTH_HASH with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-strong-password'
# Note: in .env, escape `$` as `$$` if Compose interpolates it, or set in Caddy environment.
CADDY_BASIC_AUTH_USER=admin
CADDY_BASIC_AUTH_HASH=$$2a$$14$$replacewithrealcaddybcryptpasswordhash000000000000000000
